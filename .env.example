# VerChem — environment variable template (names only, no real values)
# Copy to .env.local for local development. Production values live in the Vercel project settings.
# Never commit .env.local.

# --- Supabase (server-side service role only; the app never uses the anon key) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AIVerID OAuth (public endpoints and client id; the secret is server-only) ---
NEXT_PUBLIC_AIVERID_AUTH_URL=https://aiverid-backend-production.up.railway.app/oauth/authorize
NEXT_PUBLIC_AIVERID_TOKEN_URL=https://aiverid-backend-production.up.railway.app/oauth/token
NEXT_PUBLIC_AIVERID_USERINFO_URL=https://aiverid-backend-production.up.railway.app/oauth/userinfo
NEXT_PUBLIC_AIVERID_CLIENT_ID=your-aiverid-client-id
AIVERID_CLIENT_SECRET=your-aiverid-client-secret

# --- Session cookie (HMAC) ---
SESSION_SECRET=generate-with-openssl-rand-base64-32
# Optional: cookie domain override (default derives from the request host)
# SESSION_COOKIE_DOMAIN=

# --- Signed calculation cards (Ed25519 PKCS8 PEM, base64-encoded) ---
# Required in production; signing fails closed when absent. Dev/tests use an ephemeral key.
CARD_SIGNING_PRIVATE_KEY=

# --- Optional ---
# AI-assisted Answer Cards. Empty = the AI route reports "unavailable"; deterministic signing still works.
ANTHROPIC_API_KEY=
# NEXT_PUBLIC_DOMAIN=verchem.xyz
# NEXT_DIST_DIR=.next

# --- Ops only (not read by the app) ---
# Postgres password for `npx supabase db push`
# SUPABASE_DB_PASSWORD=
